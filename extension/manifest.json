{
  "manifest_version": 3,
  "name": "xdeporter",
  "version": "0.1.0",
  "description": "See X's public account country or region beside posts, and filter your feed by selected locations.",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "xdeporter" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["main-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://www.x.com/*", "https://twitter.com/*", "https://www.twitter.com/*"],
      "js": ["core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
